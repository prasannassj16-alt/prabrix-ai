# PRABRIX AI - Environment Variables Template
# Copy this file to .env or .env.local for local development.
# STRICT RULE: NEVER COMMIT REAL CREDENTIALS OR SECRETS TO VERSION CONTROL.

# Supabase Configuration (Frontend & Backend)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-placeholder

# Phone OTP & SMS Provider Configuration
# When VITE_OTP_DEMO_MODE=true, no external SMS is sent and the UI clearly displays:
# "Demo mode: no real SMS is sent."
VITE_OTP_DEMO_MODE=true
VITE_DEFAULT_COUNTRY_CODE=+91
VITE_OTP_COOLDOWN_SECONDS=30
VITE_MAX_OTP_ATTEMPTS=5
VITE_REQUIRE_PHONE_VERIFIED=true

# Twilio SMS Provider (Optional - for live SMS delivery when configured in Supabase)
TWILIO_ACCOUNT_SID=placeholder-twilio-sid
TWILIO_AUTH_TOKEN=placeholder-twilio-token
TWILIO_MESSAGING_SERVICE_SID=placeholder-messaging-service-sid

# Backend Server Configuration
PORT=4000
NODE_ENV=development

# Document AI / OCR Extraction API (Optional - when empty, system shows "OCR Service Unavailable")
VITE_OCR_API_KEY=
VITE_OCR_API_ENDPOINT=https://api.documentai.example.com/v1/extract

# Mobile App & Deployed Backend API URL
# When running on mobile, the app connects to the deployed backend URL instead of localhost
VITE_API_BASE_URL=https://api.prabrix.example.com

