# PRABRIX AI - Production Environment Variables Template
# Use this when building for mobile APK production releases.

# Supabase Production Credentials
VITE_SUPABASE_URL=https://your-production-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-production-anon-key

# Deployed Backend Security Gateway API
VITE_API_BASE_URL=https://api.prabrix.example.com

# Production OTP settings (live SMS)
VITE_OTP_DEMO_MODE=false
VITE_DEFAULT_COUNTRY_CODE=+91
VITE_OTP_COOLDOWN_SECONDS=60
VITE_MAX_OTP_ATTEMPTS=5
VITE_REQUIRE_PHONE_VERIFIED=true

# Google Maps / Document OCR API (Optional)
VITE_GOOGLE_MAPS_API_KEY=
VITE_OCR_API_KEY=
VITE_OCR_API_ENDPOINT=https://api.documentai.example.com/v1/extract
